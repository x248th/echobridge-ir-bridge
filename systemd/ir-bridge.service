[Unit]
Description=EchoBridge IR Bridge (addon)
# 本体とネット到達後に開始。ただし Requires= は入れない設計判断（HAP版・Matter版と同じ）:
# 本体restart時にアドオンを道連れにしない。
# 本アドオンは M2 から本体API(:8099) を叩く（受信コード→シーン発火・輝度設定）。
#   After= は「起動していれば先に」でしかなく、本体不達でも本アドオンは起動する
#   （起動時に HTTP を叩かないため。ir_bridge/main.py）。
After=network-online.target echobridge-shortcut-api.service
Wants=network-online.target

[Service]
Type=simple
User=%USER%
WorkingDirectory=%REPO%
# 起動時ローテ: error_addon.log が1MB超なら .old へ退避（世代1・上書き）。
# systemdがStandardErrorでファイルを開く前に走るためappendのinode問題を踏まない。
# クラッシュループでも再起動毎に走るので最悪1MB+αで頭打ち。%%s はunit内で%sへ復元される。
# ★これは起動時だけ。稼働中の回転はアドオン側（ir_bridge/errlog.py）が同じ閾値・同じ .old 名で行う
#   （API_CONTRACT.md §6-2「稼働中も上限を持つこと」・W18）。閾値を変えるときは両方を揃えること。
ExecStartPre=/bin/sh -c '[ -f %REPO%/data/error_addon.log ] && [ $(stat -c%%s %REPO%/data/error_addon.log) -gt 1048576 ] && mv -f %REPO%/data/error_addon.log %REPO%/data/error_addon.log.old || true'
# ログの権限を data/ の他の生成物（status.json＝600）と揃える。
# StandardError=append: は mode を指定できず、systemd が新規作成すると root:root 644 になる。
# systemd がファイルを開く**前に**先回りして作成し 600 を立てることで 644 の瞬間を作らない。
# ★この行は User=%USER% 権限で走るため、root所有で作られた既存ファイルには touch も chmod も
#   失敗する。所有権の移行は root で走る install.sh 側の責任とし、ここは末尾 true で
#   **失敗しても起動を妨げない**（install.sh を経ずに手で起動した機体で上がらなくなるのを避ける）。
ExecStartPre=/bin/sh -c 'f=%REPO%/data/error_addon.log; touch "$f" 2>/dev/null; chmod 600 "$f" 2>/dev/null; true'
ExecStart=%PYTHON% -m ir_bridge.main
# 標準ライブラリのみで動く＝venvもrequirements.txtも持たない（CLAUDE.md §11）。
# stdoutがpipe(journal)だとPythonはブロックバッファする＝ログが数KB溜まるまで出ない。
# 本体webuiのunitと同じくバッファを切り、INFOが即journalへ届くようにする。
Environment=PYTHONUNBUFFERED=1
# /dev/lirc* は root:video 660。受信（/dev/lircN を MODE2 で直接 read）と送信（ir-ctl）が
# これを開く。デバイス番号は決め打ちしない——役割は LIRC_GET_FEATURES で判定する（CLAUDE.md §12）。
# ★SupplementaryGroups= は User= のユーザが /etc/group 経由で属する群を**置換せず、加える**
#   （dev機の echobridge は既に video 所属なので実質no-opだが、非所属の機体でも効く保険）。
SupplementaryGroups=video
# 日常ログ(INFO)はstdout→journal(RAM・揮発)。WARNING以上のstderrだけを
# data/error_addon.log へ永続＝本体のerror.log思想(ERROR+必要WARNINGのみ永続)と同型。
# 振り分けはアドオン側 ir_bridge/main.py の _setup_logging が行う。
# ファイル名は全アドオン共通で error_addon.log 固定（本体診断が addons/*/data/ を1globで拾う規約）。
StandardOutput=journal
StandardError=append:%REPO%/data/error_addon.log
# 本体URLの注入点（CLAUDE.md §4: ハードコード禁止・既定は同一機のループバック）。
# M2で受信コード→シーン発火のためにこのURLを実際に叩くようになったので追加した
# （M1では「コードが読まない変数はunitに置かない」として意図的に省いていた）。
# ★127.0.0.1 であることが、本体の localhost 免除（API_CONTRACT.md §1）の条件である。
#   本アドオンは鍵（?key=）を送る手段を持たないので、この値を LAN のアドレス
#   （例 http://192.168.x.x:8099・http://echobridge.local:8099）に変えると、
#   本体のトークン認証が ON のとき全リクエストが 401 になる（localhost は免除の対象）。
Environment=ECHOBRIDGE_URL=http://127.0.0.1:8099
# 受信に使う lircデバイス。auto＝受信できる最初の1台（RXが1つだけの機体はこれで足りる）。
# RXが複数ある機体（GPIOのVS1838B + USBのIrdroid 等）は data/env で明示する。
#   IR_BRIDGE_RX_DEVICE=ir_toy       ← USB機はドライバ名で指定する（下の注記）
#   IR_BRIDGE_RX_DEVICE=/dev/lirc2   ← パスでも書ける（`lirc2` / `2` も可）
# ★USB機をパスで指定しない。/dev/lircN の番号は接続順・起動順で動く（実測: Irdroidは
#   lirc2 だが、GPIOのoverlayより先に列挙されれば別番号になりうる）。ドライバ名なら動かない。
# 名前は起動ログの「lircデバイス: … 名前=…」の行に出る（dev機: gpio-ir-tx / gpio_ir_recv / ir_toy）。
# 合致するデバイスが無いときは**自動選択に落とさず待つ**＝別のセンサで黙って受け続けない。
Environment=IR_BRIDGE_RX_DEVICE=auto
# data/env は上の既定を上書きする場合に使う（後勝ち。例: IR_BRIDGE_RX_DEVICE）。
# ★本体を別機に置く構成（ECHOBRIDGE_URL を別機のアドレスにする）は、本体のトークン認証が
#   OFF のときしか成立しない。トークン ON では全リクエストが 401 になる。
#   本アドオンには鍵を渡す手段（HAP版・Matter版の ECHOBRIDGE_TOKEN に相当するもの）が無く、
#   本体への到達を localhost 免除（API_CONTRACT.md §1）に完全に依存しているため。
# 同一機なら本体がループバック接続を認証の検査対象外にするためトークンは不要＝env自体が不要。
# "-" でファイル不在でも起動する（同一機運用では不在が既定）。
EnvironmentFile=-%REPO%/data/env
Restart=on-failure
RestartSec=5
# 上限 64M（受け渡しW15_ir-bridge_MemoryMax・2026-09-16 改訂／09-17 追補。DEV_LOG 2026-09-19 W18）。
# 実測（本体セッションが測定・dev 機＝Pi5 2GB・16K ページ・2026-09-15・約4時間の窓・IR 実装後）:
#   MemoryCurrent 13.3MiB / memory.peak 17.2MiB / anon 12.8MiB。memory.events の max・oom・oom_kill は 0。
#   （参考: 骨格時点 2026-08-14 の dev 機で RSS≈12MiB / cgroup課金≈6MiB。DEV_LOG M1-B）
# 64M の根拠は上の実測に対する2点:
#   (1) 比: 64M はピーク 17.2MiB の約3.7倍（200M だと約11.6倍で過大）。
#   (2) 隔離: 約47MiB 増えた時点で本アドオンだけが自分の天井で落ち、Restart=on-failure で戻る。
#       上限が大きいと、その間は他 unit と同じ物理メモリを取り合う。
# 32M まで締めない: cgroup は page cache も課金する。学習操作・設定画面・/diagnostics の同時利用の実測がまだ無い。
# Pi4 1GB（出荷相当）での IR 実測はまだ無い。見直す条件は受け渡しW15 §5
# （1週間以上の memory.peak が 32MiB 超／memory.events の max・oom_kill が 0 でなくなった）。
MemoryMax=64M
# 本体(未設定=0)より先にkillされる側＝「逼迫時に死ぬのはアドオン側」(CLAUDE.md §5)の実装。
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
